// Ballot Boreal privacy contract.
//
// An election authority publishes a Merkle root containing eligible member
// commitments. A voter supplies their leaf secret and Merkle path as a private
// witness. Only a ballot-scoped nullifier and the aggregate proof count become
// public; the member commitment and path are never disclosed.

pragma language_version 0.23;

import CompactStandardLibrary;

export struct MembershipWitness {
  secret: Bytes<32>;
  siblings: Vector<8, Bytes<32>>;
  siblingOnLeft: Vector<8, Boolean>;
}

export ledger ballotId: Bytes<32>;
export ledger membershipRoot: Bytes<32>;
export ledger finalizedProofs: Counter;
export ledger usedNullifiers: Set<Bytes<32>>;

witness membershipWitness(): MembershipWitness;

constructor(
  configuredBallotId: Bytes<32>,
  configuredMembershipRoot: Bytes<32>
) {
  // These values define the public verification policy for this deployment.
  ballotId = disclose(configuredBallotId);
  membershipRoot = disclose(configuredMembershipRoot);
}

export pure circuit memberLeaf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<21>, Bytes<32>]>([
    "ballot-boreal:member:",
    secret
  ]);
}

export pure circuit merkleParent(
  node: Bytes<32>,
  sibling: Bytes<32>,
  siblingOnLeft: Boolean
): Bytes<32> {
  return siblingOnLeft
    ? persistentHash<[Bytes<32>, Bytes<32>]>([sibling, node])
    : persistentHash<[Bytes<32>, Bytes<32>]>([node, sibling]);
}

export pure circuit memberRoot(witnessData: MembershipWitness): Bytes<32> {
  const level0 = memberLeaf(witnessData.secret);
  const level1 = merkleParent(level0, witnessData.siblings[0], witnessData.siblingOnLeft[0]);
  const level2 = merkleParent(level1, witnessData.siblings[1], witnessData.siblingOnLeft[1]);
  const level3 = merkleParent(level2, witnessData.siblings[2], witnessData.siblingOnLeft[2]);
  const level4 = merkleParent(level3, witnessData.siblings[3], witnessData.siblingOnLeft[3]);
  const level5 = merkleParent(level4, witnessData.siblings[4], witnessData.siblingOnLeft[4]);
  const level6 = merkleParent(level5, witnessData.siblings[5], witnessData.siblingOnLeft[5]);
  const level7 = merkleParent(level6, witnessData.siblings[6], witnessData.siblingOnLeft[6]);
  return merkleParent(level7, witnessData.siblings[7], witnessData.siblingOnLeft[7]);
}

circuit requireEligible(
  requestedBallotId: Bytes<32>
): Bytes<32> {
  const publicBallotId = disclose(requestedBallotId);
  assert(publicBallotId == ballotId, "Wrong ballot");

  const witnessData = membershipWitness();
  assert(memberRoot(witnessData) == membershipRoot, "Membership witness is not eligible");
  return witnessData.secret;
}

// Disclosure justification: the verifier learns only that the private witness
// opens to the authority-published root for this ballot.
export circuit proveEligibility(
  requestedBallotId: Bytes<32>
): Boolean {
  requireEligible(requestedBallotId);
  return disclose(true);
}

// Disclosure justification: a ballot-scoped nullifier is public so the ledger
// can reject a second use of the same private member witness. The leaf and path
// are not disclosed, and the domain includes the ballot ID to prevent linkage
// between different ballots.
export circuit castOnce(
  requestedBallotId: Bytes<32>
): Bytes<32> {
  const secret = requireEligible(requestedBallotId);
  const nullifier = persistentHash<[Bytes<24>, Bytes<32>, Bytes<32>]>([
    "ballot-boreal:nullifier:",
    ballotId,
    secret
  ]);
  const publicNullifier = disclose(nullifier);

  assert(!usedNullifiers.member(publicNullifier), "A proof was already accepted for this ballot");
  usedNullifiers.insert(publicNullifier);
  finalizedProofs.increment(1);
  return publicNullifier;
}
