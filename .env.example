# Frontend: public metadata only. Never place a private witness, seed phrase, or Gemini key here.
VITE_API_URL=http://localhost:8000
VITE_MIDNIGHT_NETWORK=preview

# Backend: use Neon pooled connection for requests and a direct URL for Alembic migrations.
DATABASE_URL=sqlite+aiosqlite:///./ballot_boreal.db
DATABASE_DIRECT_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
COMPACTC_BIN=compactc
