# Frontend: set this to the Render service URL in Netlify. Never place secrets here.
VITE_API_URL=http://localhost:8000
VITE_MIDNIGHT_NETWORK=preview

# Backend: use Neon pooled connection for API requests and a direct URL for Alembic migrations.
# Add these values to the Render web service, never to a VITE_* variable.
DATABASE_URL=sqlite+aiosqlite:///./ballot_boreal.db
DATABASE_DIRECT_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
COMPACTC_BIN=compactc
