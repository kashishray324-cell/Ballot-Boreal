{
  "name": "ballot-boreal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:netlify && vite build",
    "deploy:netlify": "npx --yes netlify-cli@latest deploy --build --prod",
    "typecheck:netlify": "tsc -p tsconfig.netlify.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:validate": "tsx scripts/validate-contract.ts",
    "contract:artifacts": "tsx scripts/check-artifacts.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/functions": "^6.0.0",
    "framer-motion": "12.23.12",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.2",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "overrides": {
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6"
  }
}
